  id: 8
  title: the Rabble Rouser
  role: Fighter / Mage
  passiveName: Happy Hour
  passiveDescription: After each ability Gragas takes a swig from his keg, healing 5.5% of his maximum health (every 12 / 10 / 8 / 6 seconds by level).
  patch: 16.20.1
  portrait: {fileID: 2800000, guid: c678ee98b2e54014b1333c3fc133b5ea, type: 3}
