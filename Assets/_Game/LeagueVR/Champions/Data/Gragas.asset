    - 80
    - 80
  - name: Drunken Rage
    vrDescription: 'X: drink from your keg for 0.75 seconds (you can keep walking). You take less damage for 2.5 seconds, and your next keg hit within 5 seconds splashes around the target for bonus magic damage plus 7% of its maximum health.'
    icon: {fileID: 2800000, guid: fb658cada4f94175bbd910ff346cd190, type: 3}
    cooldowns:
    - 5
    - 5
    - 5
    - 5
    - 5
    costs:
    - 30
