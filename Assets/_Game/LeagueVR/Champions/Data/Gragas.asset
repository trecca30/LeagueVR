  spells:
  - name: Barrel Roll
    vrDescription: 'B: hold and point your right hand at the ground (the ring shows where the barrel lands), release to roll it there. It ferments for 2 seconds, hitting harder and slowing more; press B again to burst it, or it bursts 4 seconds after it stops.'
    icon: {fileID: 2800000, guid: 50283cd61f294ef7bec63c2b7d1b14c5, type: 3}
    cooldowns:
    - 10
    - 9
    - 8
    - 7
